def calc_old():
    cur=ccyvar.get()
    #exp=tenor.get_date().strftime('%m/%d/%Y')
    exp = tenor.get_date()
    exp_dt=datetime.combine(exp,time())
#    dt_str=exp_dt.strftime("%m/%d/%Y")
    c=cutvar.get()
#    if c == "TK":
#        exp_dt=exp_dt.replace(hour=6)
#    elif c == "NY":
#        exp_dt=exp_dt.replace(hour=14)
#    exp_t=get_t_from_datetime(exp_dt)
    # new york 10 is UTC 14
    # tokyo 3 pm is UTC 6
 #   svol=vp.vs[cur].get_vol(float(strikevar.get())/float(fwdvar.get()),exp_t,interpvar.get())
    atm_only=atm_only_var.get()
    if atm_only:
        svol=vp.vs[cur].get_atm_cut_vol(exp_dt,c)*100
    else:
        try:
            svol = vp.vs[cur].get_vol(float(strikevar.get()) / float(fwdvar.get()), exp_dt, interpvar.get(), "vol", c) * 100
        except:
            svol = 0
    outputvar.set('%.4f' % svol)

def get_strike():
    cur=ccyvar.get()
    exp = tenor.get_date()
    exp_dt=datetime.combine(exp,time())
    c=cutvar.get()
    delta=slider_var.get()/100
    opt_call=call_put_button.config('text')[-1]=='call'
    opt_delta=delta
    if not opt_call:
        opt_delta=delta*-1
    [opt_strike,opt_v]=vp.vs[cur].get_delta_strike(get_t_from_datetime(exp_dt),opt_delta,opt_call)
    fwd=1
    if not fwdvar.get():
        fwdvar.set("1")
    else:
        fwd=float(fwdvar.get())
    output_strike=str(opt_strike*fwd)
    strikevar.set(output_strike)
        
def calc():
    cur=ccyvar.get()
    exp = tenor.get_date()
    exp_dt=datetime.combine(exp,time())
    c=cutvar.get()
    output_type=output_option_var.get()
    delta=slider_var.get()/100
    if output_type == "Atm":
        output=vp.vs[cur].get_atm_cut_vol(exp_dt,c)*100
    elif output_type == "Strike":
        try:
            output = vp.vs[cur].get_vol(float(strikevar.get()) / float(fwdvar.get()), exp_dt, interpvar.get(), "vol", c) * 100
        except:
            output = 0
    elif output_type == "Daily":
        exp_dt = exp_dt.replace(hour=0,minute=0,second=0)
        output = vp.vs[cur].get_daily_curve_vol(exp_dt)
    elif output_type == "Delta":
        opt_call = call_put_button.config('text')[-1]=='call'
        opt_delta = delta
        if not opt_call:
            opt_delta = opt_delta * -1
        [opt_strike,opt_v]=vp.vs[cur].get_delta_strike(get_t_from_datetime(exp_dt),opt_delta,opt_call)
        output=opt_v * 100
    elif output_type == "RR":
        output=vp.vs[cur].getRR(get_t_from_datetime(exp_dt),delta)*100
    elif output_type == "Fly":
        output=vp.vs[cur].getST(get_t_from_datetime(exp_dt),delta)*100
    else:
        output=0
    outputvar.set('%.4f' % output)


def calc_daily_curve():
    #nyc to nyc so there's no cut input. just curve daily no surface either
    cur=ccyvar.get()
    exp = tenor.get_date()
    exp_dt = datetime.combine(exp,time())
    ## make sure it falls into the right NYC day and convert equivalent UTC day for daily vol
    exp_dt = exp_dt.replace(hour=0,minute=0,second=0)
    dvol = vp.vs[cur].get_daily_curve_vol(exp_dt)
    outputvar.set('%.4f' % dvol)

def print_out():
    print_type=print_var.get()
    if print_type == "Tenor":
        print_tenor()
    elif print_type == "Surf":
        print_surf_param()
    elif print_type == "SABR":
        print_sabr()     
    else:
        print("ERROR")

def show_pt():
    pt.grid(row=2,column=0)

def print_tenor():
    cur = ccyvar.get()
    pt.delete('1.0',END)
    for tp in vp.tenor_points:
        pt.insert(END,str(tp) + "\t" + '%.3f' % vp.vs[cur].atm_vols.getVol(get_years_time(tp))+'\n')
    #for name, var in choices.items():
    #    pt.insert(END,str(name)+"\t" + '%d' % var.get() + '\n')
    #pt.pack()
    show_pt()

def print_surf_param():
    cur = ccyvar.get()
    pt.delete('1.0',END)
    target_mx = vp.vs[cur].param_matrix
    target_raw = vp.vs[cur].surf_matrix
    pt.insert(END,"EXPIRY\trho25\trho10\tslog25\tslog10\n")
    for i,r in target_mx.iterrows():
        time_str=target_raw['expiry'].iloc[i]
        pt.insert(END, str(time_str) + '\t%.2f\t%.2f\t%.2f\t%.2f\n' % (r['RR 25D'],r['RR 10D'],r['ST 25D'],r['ST 10D']))
    #pt.pack()
    show_pt()

def print_sabr():
    cur = ccyvar.get()
    pt.delete('1.0',END)
    sbm = vp.vs[cur].sabr_params
    pt.insert(END,"\trho25\trho10\tslog25\tslog10\n")
    pt.insert(END,'init\t%.2f\t%.2f\t%.2f\t%.2f\n' % (sbm[0,2],sbm[0,3],sbm[0,1],sbm[0,0]))
    pt.insert(END,'final\t%.2f\t%.2f\t%.2f\t%.2f\n' % (sbm[1,2],sbm[1,3],sbm[1,1],sbm[1,0]))
    pt.insert(END,'decay\t%.2f\t%.2f\t%.2f\t%.2f\n' % (sbm[2,2],sbm[2,3],sbm[2,1],sbm[2,0]))
    #pt.pack()
    show_pt()

def call_put_switch():
    if call_put_button.config('text')[-1]=='call':
        call_put_button.config(text='put')
    else:
        call_put_button.config(text='call')

def overwrite_sabr():
    cur = ccyvar.get()
    tnr=overwrite_tenor_var.get()
    col=overwrite_col_var.get()
    val=overwrite_value_var.get()
    col_num=0
    col_name=""
    #target_expiry_options+sabr_param_rows
    #"rho25","rho10","slog25","slog10"
    if col == 'rho25':
        col_num=2
        col_name="RR 25D"
    elif col == 'rho10':
        col_num=3
        col_name="RR 10D"
    elif col == 'slog25':
        col_num=1
        col_name="ST 25D"
    elif col == 'slog10':
        col_num=0
        col_name="ST 10D"
    else:
        print ("ERROR!")
    if tnr in sabr_param_rows:
        row_number=sabr_param_rows.index(tnr)
        vp.vs[cur].sabr_params[row_number,col_num]=val
    else:
        row_number=target_expiry_options.index(tnr)
        vp.vs[cur].param_matrix[col_name].iloc[row_number]=val
        #vp.vs[cur].param_matrix[col_name][row_number]=val

