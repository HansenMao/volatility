vp=Vols(file_path+"vol_marks.xlsx")

def run_indication():
    # indication parameters
    ind_config_tab="Indication Config"
    ind_tab="Indication"
    dt_format="%d-%b-%y"
    ##wb=xlrd.open_workbook(param_file)
    wb=xlrd.open_workbook(FILE_PATH+"vol_marks.xlsx")
    ws=wb.sheet_by_name('INDIC_CONFIG')
    config_file=ws.cell(0,0).value
    xls=pd.ExcelFile(config_file)
    config = pd.read_excel(xls, ind_config_tab,index_col=0)
    ind = pd.read_excel(xls,ind_tab)
    dfo = pd.DataFrame(columns=['d','v','s','f','p'], index=ind.index)
    for i in ind.index:
        # loop through rows
        d = ind['DATE'][i]
        f = ind['FWD'][i]
        c = ind['CCY'][i]
        s = ind['STRIKE'][i]
        r = ind['ROUNDING'][i]
        ot = ind['TYPE'][i]
        # add feature so if d is already a date string no need to call this function
        #if isinstance(d,str) and re.match("[0-9]+[w|W|m|M]{1}",d):
         #   exp_date = getbday(c,d)
        #else:
        #    exp_date = datetime.strptime(d, dt_format)
        if isinstance(d,str):
            exp_date = getbday(c,d)
        else:
            exp_date = d
        spot = config["SPOT"][c]
        swap = config[f.upper()][c]
        fwd = spot + swap / 10000
        strike = spot + s / 10000
        if isinstance(r,int):
            strike = round(strike,r)
        vol = vp.vs[c].get_vol(float(strike) / float(fwd), exp_date, "SVI") * 100
        vol2use = vol - config[f.upper()+"_SP"][c]
        cur_dt=datetime.combine(date.today(),time())
        t=(exp_date-cur_dt).days/365
        if ot.upper() == 'C':
            if_call = True
        elif ot.upper() == 'P':
            if_call = False
        else:
            if_call = strike > fwd
        prem=getBSPV(fwd,strike,vol2use/100,t,if_call,True)
        dfo.loc[i] = pd.Series({'d':exp_date.strftime(dt_format),'v':vol2use,'s':strike,'f':fwd,'p':prem})
    book = load_workbook(config_file)
    writer = pd.ExcelWriter(config_file,engine='openpyxl')
    writer.book=book
    writer.sheets=dict((ws.title,ws) for ws in book.worksheets)
    dfo.to_excel(writer,ind_tab,header=None,index=False,startcol=6, startrow=1)
    writer.save()

def print_daily_vols():
    #generate list of dates
    cur = ccyvar.get()
    daily_vol_output_file=file_path+cur+"_daily_vol"
    f=open(daily_vol_output_file,"w")
    end_t=float(daily_vol_end_time)
    t0=datetime.utcnow()
    tn=t0+timedelta(days=end_t*365)
    t=t0
    tenor_daily = tenor_daily_var.get()
    cut=cutvar.get()
    while t<tn:
        exp_dt = datetime.combine(t,time())
        exp_dt = exp_dt.replace(hour=0,minute=0,second=0)
        if tenor_daily:
            dvol = vp.vs[cur].get_atm_cut_vol(exp_dt,cut) * 100
        else:
            dvol = vp.vs[cur].get_daily_curve_vol(exp_dt)
        ##print ('{}: {}'.format(t,dvol))
        f.write('{}, {}\n'.format(t.strftime("%Y/%m/%d"),dvol))
        t=t+timedelta(hours=24)
    f.close()

def print_daily_vols_new():
    #generate list of dates
    cur = ccyvar.get()
    daily_vol_output_file=file_path+cur+"_daily_vol"
    f=open(daily_vol_output_file,"w")
    end_t=float(daily_vol_end_time)
    t0=datetime.utcnow()
    tn=t0+timedelta(days=end_t*365)
    t=t0
    #tenor_daily = tenor_daily_var.get()
    tenor_daily = True
    cut=cutvar.get()
    if not tenor_daily:
#        while t<tn:
#            exp_dt = datetime.combine(t,time())
#            exp_dt = exp_dt.replace(hour=0,minute=0,second=0)
#            #if tenor_daily:
#            #    dvol = vp.vs[cur].get_atm_cut_vol(exp_dt,cut) * 100
#            #else:
#            dvol = vp.vs[cur].get_daily_curve_vol(exp_dt)
#            ##print ('{}: {}'.format(t,dvol))
#            f.write('{}, {}\n'.format(t.strftime("%Y/%m/%d"),dvol))
#            t=t+timedelta(hours=24)
        vp.vs[cur].atm_vols.refreshDailyCumulativeVols(end_t,cut)
        dvols = vp.vs[cur].atm_vols.daily_vols
        for d in dvols:
            f.write('{}, {}\n'.format(d,dvols[d]))
    else:
        # print daily which can be directly read off your internal property
        vp.vs[cur].atm_vols.refreshDailyCumulativeVols(end_t,cut)
        dvols = vp.vs[cur].atm_vols.daily_cumulative_vols
        for d in dvols:
            f.write('{}, {}\n'.format(d,dvols[d]))
    f.close()



